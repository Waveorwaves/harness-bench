# Copy this file to .env, fill in the keys you use, then run: chmod 600 .env
# .env is ignored by git. Never commit it and never paste these values into a chat or an issue.
#
# A key only reaches a harness if the suite names it in that harness's "env" list
# (or in a model's "harness_env"). `python3 -m harness_bench check --suite <suite>` tells
# you which named keys are missing, without ever showing a value.

# DeepSeek API (pay per use)
DEEPSEEK_API_KEY=

# OpenAI API (pay per use). This is NOT your ChatGPT or Codex subscription:
# a subscription is a login, not a key, and cannot be put in this file.
OPENAI_API_KEY=

# Factory, for Droid
FACTORY_API_KEY=
