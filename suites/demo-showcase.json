  "tasks": [
    {"id": "sunset-sail", "spec": "tasks/sunset-sail", "seed_revision": null, "evaluator_revision": null},
    {"id": "pirate-ship-3d", "spec": "tasks/pirate-ship-3d", "seed_revision": null, "evaluator_revision": null}
  ],
  "harnesses": [
    {"id": "sample-reference", "adapter": "mock", "args": ["reference"], "version": null},
    {"id": "sample-small-model", "adapter": "mock", "args": ["variant", "small-model"], "version": null},
    {"id": "sample-mid-model", "adapter": "mock", "args": ["variant", "mid-model"], "version": null},
    {"id": "sample-large-model", "adapter": "mock", "args": ["variant", "large-model"], "version": null, "tasks": ["pirate-ship-3d"]},
    {"id": "sample-plain", "adapter": "mock", "args": ["variant", "plain"], "version": null, "tasks": ["sunset-sail"]},
    {"id": "sample-faulty", "adapter": "mock", "args": ["variant", "broken"], "version": null, "tasks": ["sunset-sail"]}
  ]
